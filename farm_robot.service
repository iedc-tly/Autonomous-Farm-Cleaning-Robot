[Unit]
Description=Autonomous Farm Cleaner Robot Boss & App Service
After=network-online.target pigpiod.service
Wants=network-online.target pigpiod.service

[Service]
Type=simple
User=iedctly
WorkingDirectory=/home/iedctly/ros2_ws
Environment=PYTHONUNBUFFERED=1
Environment=ROS_LOG_DIR=/tmp
Environment=HOME=/home/iedctly
ExecStart=/bin/bash /home/iedctly/ros2_ws/run_boss.sh
Restart=always
RestartSec=5s
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target

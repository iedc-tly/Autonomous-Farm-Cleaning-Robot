[Unit]
Description=Autonomous Farm Cleaner 3-Button Robot Service
After=network-online.target pigpiod.service
Wants=network-online.target pigpiod.service

[Service]
Type=simple
User=iedctly
WorkingDirectory=/home/iedctly/ros2_ws
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash /home/iedctly/ros2_ws/allrun.sh --headless
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
